# Not currently used by the active tool set (see README.md) -- the
# character/npc/terrain/physics tools that needed a model key of their own
# are shelved pending a rewrite. Left here for when they return.
ANTHROPIC_API_KEY=
# Some hosted environments reserve ANTHROPIC_API_KEY for their own credential
# plumbing; set STORY_SIM_ANTHROPIC_API_KEY there instead and it takes
# precedence (see story_simulator/config.py:resolve_anthropic_api_key).
STORY_SIM_ANTHROPIC_API_KEY=

# Registry database (any ibis.connect-resolvable URL). Defaults to Postgres --
# postgresql://postgres:postgres@localhost:5432/postgres, matching GitHub
# Actions' postgres: service container -- if unset.
STORY_SIM_DATABASE_DSN=

# Which responder a due base event asks: "host" (default -- the connected
# agent decides inline), "subagent" (ask it to delegate to its own
# isolated subagent mechanism instead, e.g. Claude Code's Agent/Task tool),
# or "keyed_subagent" (answered directly, in-process, via a separate model
# call -- see story_simulator/config.py:event_responder). Leave unset for
# today's default behavior.
STORY_SIM_RESPONDER=

# LiteLLM model string the "keyed_subagent" responder calls directly.
# Defaults to deepseek/deepseek-chat -- see
# story_simulator/config.py:keyed_subagent_model. Its API key comes from
# whichever env var that provider's LiteLLM integration expects (e.g.
# DEEPSEEK_API_KEY), not from this file.
STORY_SIM_SUBAGENT_MODEL=

# Which responder tests/test_human_validated.py's HeadlessSession defaults
# to for a live test (tests/test_*_live.py) that doesn't pin one
# explicitly -- independent of STORY_SIM_RESPONDER above, which is read by
# a real deployment, not by the live test harness. Defaults to
# "keyed_subagent" if unset; set to "host" here (or per-run:
# `STORY_SIM_LIVE_TEST_RESPONDER=host uv run pytest -m live`) to flip the
# whole suite's default back without editing any test file.
STORY_SIM_LIVE_TEST_RESPONDER=
