# Not currently used by the active tool set (see README.md) -- the
# character/npc/terrain/physics tools that needed a model key of their own
# are shelved pending a rewrite. Left here for when they return.
ANTHROPIC_API_KEY=
# Some hosted environments reserve ANTHROPIC_API_KEY for their own credential
# plumbing; set STORY_SIM_ANTHROPIC_API_KEY there instead and it takes
# precedence (see story_simulator/config.py:resolve_anthropic_api_key).
STORY_SIM_ANTHROPIC_API_KEY=

# Registry database (any ibis.connect-resolvable URL). Defaults to Postgres --
# postgresql://postgres:postgres@localhost:5432/postgres, matching GitHub
# Actions' postgres: service container -- if unset.
STORY_SIM_DATABASE_DSN=
