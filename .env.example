# Not currently used by the active tool set (see README.md) -- the
# character/npc/terrain/physics tools that needed one are shelved.
ANTHROPIC_API_KEY=
# Some hosted environments reserve ANTHROPIC_API_KEY for their own
# credential plumbing; set STORY_SIM_ANTHROPIC_API_KEY here instead.
STORY_SIM_ANTHROPIC_API_KEY=

# Registry database (any ibis.connect-resolvable URL). Defaults to
# Postgres (postgresql://postgres:postgres@localhost:5432/postgres) if unset.
STORY_SIM_DATABASE_DSN=

# Which responder a due base event asks: "host" (default), "subagent",
# or "keyed_subagent" -- see story_simulator/config.py:event_responder.
STORY_SIM_RESPONDER=

# LiteLLM model string the "keyed_subagent" responder calls directly.
# Defaults to deepseek/deepseek-chat -- see config.py:keyed_subagent_model.
STORY_SIM_SUBAGENT_MODEL=

# Which responder a live test (tests/test_*_live.py) that doesn't pin
# one explicitly defaults to. Defaults to "host" if unset.
STORY_SIM_LIVE_TEST_RESPONDER=
